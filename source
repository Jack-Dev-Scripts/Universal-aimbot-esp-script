local Colors = {
    Background = Color3.fromRGB(8,8,15),
    Panel = Color3.fromRGB(15,12,28),
    Card = Color3.fromRGB(20,18,36),

    Accent = Color3.fromRGB(190,70,255),
    Accent2 = Color3.fromRGB(0,180,255),

    Success = Color3.fromRGB(0,255,150),

    Text = Color3.fromRGB(245,245,255),
    SubText = Color3.fromRGB(155,160,185)
}

-- Main window size (fixed overflow)
Main.Size = UDim2.fromOffset(760,580)
Main.Position = UDim2.new(.5,-380,.5,-290)

Sidebar.Size = UDim2.fromOffset(185,490)
Content.Size = UDim2.fromOffset(540,490)

-- Glass effect
local GlowStroke = Instance.new("UIStroke")
GlowStroke.Color = Colors.Accent
GlowStroke.Thickness = 2
GlowStroke.Transparency = .2
GlowStroke.Parent = Main

local Gradient = Instance.new("UIGradient")
Gradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Colors.Accent),
    ColorSequenceKeypoint.new(1, Colors.Accent2)
})
Gradient.Rotation = 45
Gradient.Parent = GlowStroke

print("JackDev Premium UI Loaded.")
