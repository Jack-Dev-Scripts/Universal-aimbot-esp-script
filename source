--==================================================
-- ESP LOGIC
--==================================================

local function CreateESP(player)
	if player == LocalPlayer or not player.Character then return end

	local Old = player.Character:FindFirstChild("JackDevESP")
	if Old then Old:Destroy() end

	local Highlight = Instance.new("Highlight")
	Highlight.Name = "JackDevESP"
	Highlight.FillColor = Settings.ESPColor
	Highlight.OutlineColor = Color3.new(1, 1, 1)
	Highlight.FillTransparency = 0.6
	Highlight.OutlineTransparency = 0
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	Highlight.Enabled = Settings.ESP
	Highlight.Parent = player.Character
end

local function UpdateESP()
	for _, player in Players:GetPlayers() do
		if player ~= LocalPlayer and player.Character then
			local Highlight = player.Character:FindFirstChild("JackDevESP")
			if Highlight then
				Highlight.Enabled = Settings.ESP
				Highlight.FillColor = Settings.ESPColor
			end
		end
	end
end

for _, player in Players:GetPlayers() do
	if player ~= LocalPlayer then
		if player.Character then CreateESP(player) end
		table.insert(Connections, player.CharacterAdded:Connect(function()
			task.wait(0.5)
			if SystemActive then CreateESP(player) end
		end))
	end
end

table.insert(Connections, Players.PlayerAdded:Connect(function(player)
	table.insert(Connections, player.CharacterAdded:Connect(function()
		task.wait(0.5)
		if SystemActive then CreateESP(player) end
	end))
end))

--==================================================
-- TARGETING LOGIC
--==================================================

local function GetNearestPlayer()
	local ClosestPlayer = nil
	local ClosestDistance = Settings.FOV
	local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

	for _, player in Players:GetPlayers() do
		if player ~= LocalPlayer and player.Character then
			local Humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			local TargetPart = player.Character:FindFirstChild(Settings.TargetPart)

			if Humanoid and TargetPart and Humanoid.Health > 0 then
				local Position, OnScreen = Camera:WorldToViewportPoint(TargetPart.Position)
				if OnScreen and Position.Z > 0 then
					local Distance = (Vector2.new(Position.X, Position.Y) - Center).Magnitude
					if Distance < ClosestDistance then
						ClosestDistance = Distance
						ClosestPlayer = player
					end
				end
			end
		end
	end
	return ClosestPlayer
end

local function ValidTarget(Player)
	if not Player or Player == LocalPlayer or not Player.Character then return false end
	local Humanoid = Player.Character:FindFirstChildOfClass("Humanoid")
	local TargetPart = Player.Character:FindFirstChild(Settings.TargetPart)

	if not Humanoid or not TargetPart or Humanoid.Health <= 0 then return false end

	local Position, OnScreen = Camera:WorldToViewportPoint(TargetPart.Position)
	if not OnScreen or Position.Z <= 0 then return false end

	local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	return (Vector2.new(Position.X, Position.Y) - Center).Magnitude <= Settings.FOV
end

--==================================================
-- INPUT & BINDINGS
--==================================================

HeadKeyButton.MouseButton1Click:Connect(function()
	if ListeningForChestKey or ListeningForUIKey then return end
	ListeningForHeadKey = true
	HeadKeyButton.Text = "Press Key..."
end)

ChestKeyButton.MouseButton1Click:Connect(function()
	if ListeningForHeadKey or ListeningForUIKey then return end
	ListeningForChestKey = true
	ChestKeyButton.Text = "Press Key..."
end)

UIKeyButton.MouseButton1Click:Connect(function()
	if ListeningForHeadKey or ListeningForChestKey then return end
	ListeningForUIKey = true
	UIKeyButton.Text = "Press Key..."
end)

table.insert(Connections, UserInputService.InputBegan:Connect(function(input, processed)
	if not SystemActive or input.UserInputType ~= Enum.UserInputType.Keyboard then return end

	if ListeningForHeadKey then
		Settings.HeadLockKey = input.KeyCode
		ListeningForHeadKey = false
		HeadKeyButton.Text = Settings.HeadLockKey.Name
		return
	end

	if ListeningForChestKey then
		Settings.ChestLockKey = input.KeyCode
		ListeningForChestKey = false
		ChestKeyButton.Text = Settings.ChestLockKey.Name
		return
	end

	if ListeningForUIKey then
		Settings.UIToggleKey = input.KeyCode
		ListeningForUIKey = false
		UIKeyButton.Text = Settings.UIToggleKey.Name
		return
	end

	if processed then return end

	if input.KeyCode == Settings.UIToggleKey then
		Main.Visible = not Main.Visible
	elseif input.KeyCode == Settings.HeadLockKey then
		if Settings.LockOn and Settings.TargetPart == "Head" then
			Settings.LockOn = false
		else
			Settings.LockOn = true
			Settings.TargetPart = "Head"
		end
		LockedTarget = Settings.LockOn and GetNearestPlayer() or nil
		UpdateLockUI()
	elseif input.KeyCode == Settings.ChestLockKey then
		if Settings.LockOn and Settings.TargetPart == "HumanoidRootPart" then
			Settings.LockOn = false
		else
			Settings.LockOn = true
			Settings.TargetPart = "HumanoidRootPart"
		end
		LockedTarget = Settings.LockOn and GetNearestPlayer() or nil
		UpdateLockUI()
	end
end))

--==================================================
-- MAIN LOOP
--==================================================

table.insert(Connections, RunService.RenderStepped:Connect(function()
	if not SystemActive then return end

	UpdateFOVCircle()
	UpdateESP()

	if not Settings.LockOn then return end

	if not ValidTarget(LockedTarget) then
		LockedTarget = GetNearestPlayer()
	end

	if LockedTarget and LockedTarget.Character then
		local TargetPart = LockedTarget.Character:FindFirstChild(Settings.TargetPart)
		if TargetPart then
			local TargetCFrame = CFrame.lookAt(Camera.CFrame.Position, TargetPart.Position)
			if Settings.Smoothness <= 0 then
				Camera.CFrame = TargetCFrame
			else
				Camera.CFrame = Camera.CFrame:Lerp(TargetCFrame, Settings.Smoothness)
			end
		end
	end
end))

--==================================================
-- DRAGGING LOGIC
--==================================================

local Dragging, DragStart, StartPosition

TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		Dragging = true
		DragStart = input.Position
		StartPosition = Main.Position
	end
end)

TopBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		Dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if Dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local Delta = input.Position - DragStart
		Main.Position = UDim2.new(
			StartPosition.X.Scale,
			StartPosition.X.Offset + Delta.X,
			StartPosition.Y.Scale,
			StartPosition.Y.Offset + Delta.Y
		)
	end
end)

--==================================================
-- SHUTDOWN
--==================================================

local function Shutdown()
	if not SystemActive then return end
	SystemActive = false

	for _, conn in ipairs(Connections) do
		if conn and conn.Connected then conn:Disconnect() end
	end
	table.clear(Connections)

	for _, player in Players:GetPlayers() do
		if player.Character then
			local ESP = player.Character:FindFirstChild("JackDevESP")
			if ESP then ESP:Destroy() end
		end
	end

	ScreenGui:Destroy()
end

CloseButton.MouseButton1Click:Connect(Shutdown)

