local function createESP(player)
	if player == LocalPlayer then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local oldHighlight = character:FindFirstChild("PlayerESP")
	if oldHighlight then
		oldHighlight:Destroy()
	end

	local oldName = character:FindFirstChild("ESPName")
	if oldName then
		oldName:Destroy()
	end

	local Highlight = Instance.new("Highlight")
	Highlight.Name = "PlayerESP"
	Highlight.FillColor = Settings.ESPColor
	Highlight.OutlineColor = Color3.new(1, 1, 1)
	Highlight.FillTransparency = 0.5
	Highlight.OutlineTransparency = 0
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	Highlight.Enabled = Settings.ESP
	Highlight.Parent = character

	local Head = character:FindFirstChild("Head")

	if Head then
		local Billboard = Instance.new("BillboardGui")
		Billboard.Name = "ESPName"
		Billboard.Size = UDim2.fromOffset(200, 40)
		Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
		Billboard.AlwaysOnTop = true
		Billboard.Enabled = Settings.ESP
		Billboard.Parent = character

		local NameLabel = Instance.new("TextLabel")
		NameLabel.Size = UDim2.fromScale(1, 1)
		NameLabel.BackgroundTransparency = 1
		NameLabel.Text = player.DisplayName
		NameLabel.TextColor3 = Settings.ESPColor
		NameLabel.TextStrokeTransparency = 0
		NameLabel.TextScaled = true
		NameLabel.Font = Enum.Font.GothamBold
		NameLabel.Parent = Billboard
	end
end

local function updateAllESP()
	for _, player in Players:GetPlayers() do
		if player ~= LocalPlayer then

			local character = player.Character

			if character then

				local highlight =
					character:FindFirstChild("PlayerESP")

				local nameTag =
					character:FindFirstChild("ESPName")

				if highlight then
					highlight.Enabled = Settings.ESP
					highlight.FillColor = Settings.ESPColor
				end

				if nameTag then
					nameTag.Enabled = Settings.ESP

					local label =
						nameTag:FindFirstChildOfClass("TextLabel")

					if label then
						label.TextColor3 = Settings.ESPColor
					end
				end
			end
		end
	end
end

for _, player in Players:GetPlayers() do
	if player ~= LocalPlayer then

		if player.Character then
			createESP(player)
		end

		table.insert(Connections, player.CharacterAdded:Connect(function()
			task.wait(0.5)

			if SystemActive then
				createESP(player)
			end
		end))
	end
end

table.insert(Connections, Players.PlayerAdded:Connect(function(player)

	table.insert(Connections, player.CharacterAdded:Connect(function()
		task.wait(0.5)

		if SystemActive then
			createESP(player)
		end
	end))
end))

--==================================================
-- TARGETING
--==================================================

local function getNearestPlayer()
	local closestPlayer = nil
	local closestDistance = Settings.FOV

	local viewportCenter = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	for _, player in Players:GetPlayers() do

		if player ~= LocalPlayer then

			local character = player.Character

			local humanoid =
				character
				and character:FindFirstChildOfClass("Humanoid")

			local head =
				character
				and character:FindFirstChild("Head")

			if humanoid
				and head
				and humanoid.Health > 0 then

				local screenPosition, onScreen =
					Camera:WorldToViewportPoint(head.Position)

				if onScreen and screenPosition.Z > 0 then

					local distance =
						(
							Vector2.new(
								screenPosition.X,
								screenPosition.Y
							) - viewportCenter
						).Magnitude

					if distance < closestDistance then
						closestDistance = distance
						closestPlayer = player
					end
				end
			end
		end
	end

	return closestPlayer
end

local function isValidTarget(player)

	if not player or player == LocalPlayer then
		return false
	end

	local character = player.Character

	if not character then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local head =
		character:FindFirstChild("Head")

	if not humanoid
		or not head
		or humanoid.Health <= 0 then

		return false
	end

	local screenPosition, onScreen =
		Camera:WorldToViewportPoint(head.Position)

	if not onScreen or screenPosition.Z <= 0 then
		return false
	end

	local center = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	local distance =
		(
			Vector2.new(
				screenPosition.X,
				screenPosition.Y
			) - center
		).Magnitude

	return distance <= Settings.FOV
end

--==================================================
-- KEYBINDS
--==================================================

table.insert(Connections, UserInputService.InputBegan:Connect(function(
	input,
	gameProcessed
)

	if not SystemActive then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	-- Selecting lock key
	if listeningForLockKey then
		Settings.LockKey = input.KeyCode
		listeningForLockKey = false

		updateLockKeyButton()
		return
	end

	-- Selecting UI key
	if listeningForUIKey then
		Settings.UIToggleKey = input.KeyCode
		listeningForUIKey = false

		updateUIKeyButton()
		return
	end

	if gameProcessed then
		return
	end

	-- UI toggle
	if input.KeyCode == Settings.UIToggleKey then
		Main.Visible = not Main.Visible
		return
	end

	-- Lock-on toggle
	if input.KeyCode == Settings.LockKey then

		Settings.LockOn = not Settings.LockOn

		if Settings.LockOn then
			lockedTarget = getNearestPlayer()
		else
			lockedTarget = nil
		end

		updateLockButton()
	end
end))

--==================================================
-- MAIN LOOP
--==================================================

table.insert(Connections, RunService.RenderStepped:Connect(function()

	if not SystemActive then
		return
	end

	updateFOVCircle()
	updateAllESP()

	if not Settings.LockOn then
		return
	end

	if not isValidTarget(lockedTarget) then
		lockedTarget = getNearestPlayer()
	end

	if lockedTarget then

		local character = lockedTarget.Character

		local head =
			character
			and character:FindFirstChild("Head")

		if head then

			local cameraPosition =
				Camera.CFrame.Position

			local targetCFrame =
				CFrame.lookAt(
					cameraPosition,
					head.Position
				)

			if Settings.Smoothness <= 0 then
				Camera.CFrame = targetCFrame
			else
				Camera.CFrame =
					Camera.CFrame:Lerp(
						targetCFrame,
						Settings.Smoothness
					)
			end
		end
	end
end))

--==================================================
-- CLOSE / REMOVE EVERYTHING
--==================================================

local function shutdown()

	if not SystemActive then
		return
	end

	SystemActive = false
	Settings.LockOn = false
	lockedTarget = nil

	-- Disconnect every connection
	for _, connection in ipairs(Connections) do
		if connection and connection.Connected then
			connection:Disconnect()
		end
	end

	table.clear(Connections)

	-- Remove ESP from every player
	for _, player in Players:GetPlayers() do

		if player.Character then

			local highlight =
				player.Character:FindFirstChild("PlayerESP")

			if highlight then
				highlight:Destroy()
			end

			local nameTag =
				player.Character:FindFirstChild("ESPName")

			if nameTag then
				nameTag:Destroy()
			end
		end
	end

	-- Remove the entire UI/FOV
	ScreenGui:Destroy()
end

CloseButton.MouseButton1Click:Connect(shutdown)

