-- Toggle visuals
local function SetToggle(button,on)
    button.Text = on and "ON" or "OFF"
    Tween(button,{
        BackgroundColor3 = on and Colors.Accent or Colors.Button,
        TextColor3 = on and Color3.new(1,1,1) or Colors.SubText
    },0.15)
end

function UpdateLockUI()
    SetToggle(LockToggle,Settings.LockPart=="Head")
end

function UpdateChestUI()
    SetToggle(ChestToggle,Settings.LockPart=="Chest")
end

-- Exclusive toggles
LockToggle.MouseButton1Click:Connect(function()
    if Settings.LockPart=="Head" then
        Settings.LockPart="None"
        Settings.LockOn=false
    else
        Settings.LockPart="Head"
        Settings.LockOn=true
    end
    LockedTarget=nil
    UpdateLockUI()
    UpdateChestUI()
end)

ChestToggle.MouseButton1Click:Connect(function()
