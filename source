-- KEYBIND BUTTONS
--==================================================

LockKeyButton.MouseButton1Click:Connect(function()

	if ListeningForUIKey then
		return
	end

	ListeningForLockKey = true

	LockKeyButton.Text =
		"Press key..."
end)

UIKeyButton.MouseButton1Click:Connect(function()

	if ListeningForLockKey then
		return
	end

	ListeningForUIKey = true

	UIKeyButton.Text =
		"Press key..."
end)

table.insert(
	Connections,

	UserInputService.InputBegan:Connect(
		function(input, processed)

			if not SystemActive then
				return
			end

			if input.UserInputType
				~= Enum.UserInputType.Keyboard then

				return
			end

			if ListeningForLockKey then

				Settings.LockKey =
					input.KeyCode

				ListeningForLockKey =
					false

				LockKeyButton.Text =
					Settings.LockKey.Name

				return
			end

			if ListeningForUIKey then

				Settings.UIToggleKey =
					input.KeyCode

				ListeningForUIKey =
					false

				UIKeyButton.Text =
					Settings.UIToggleKey.Name

				return
			end

			if processed then
				return
			end

			-- UI toggle
			if input.KeyCode ==
				Settings.UIToggleKey then

				Main.Visible =
					not Main.Visible

				return
			end

			-- Lock toggle
			if input.KeyCode ==
				Settings.LockKey then

				Settings.LockOn =
					not Settings.LockOn

				if Settings.LockOn then

					LockedTarget =
						GetNearestPlayer()

				else

					LockedTarget =
						nil
				end

				UpdateLockUI()
			end
		end
	)
)

--==================================================
-- RENDER LOOP
--==================================================

table.insert(
	Connections,

	RunService.RenderStepped:Connect(
		function()

			if not SystemActive then
				return
			end

			UpdateFOVCircle()
			UpdateESP()

			if not Settings.LockOn then
				return
			end

			if not ValidTarget(
				LockedTarget
			) then

				LockedTarget =
					GetNearestPlayer()
			end

			if LockedTarget then

				local Character =
					LockedTarget.Character

				local Head =
					Character
					and Character:FindFirstChild(
						"Head"
					)

				if Head then

					local TargetCFrame =
						CFrame.lookAt(
							Camera.CFrame.Position,
							AimPart.Position
						)

					if Settings.Smoothness <= 0 then

						Camera.CFrame =
							TargetCFrame

					else

						Camera.CFrame =
							Camera.CFrame:Lerp(
								TargetCFrame,
								Settings.Smoothness
							)
					end
				end
			end
		end
	)
)

--==================================================
-- DRAG WINDOW
--==================================================

local Dragging = false
local DragStart
local StartPosition

TopBar.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1 then

		Dragging = true
		DragStart = input.Position
		StartPosition = Main.Position
	end
end)

TopBar.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1 then

		Dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if not Dragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement then

		local Delta =
			input.Position - DragStart

		Main.Position =
			UDim2.new(
				StartPosition.X.Scale,
				StartPosition.X.Offset + Delta.X,
				StartPosition.Y.Scale,
				StartPosition.Y.Offset + Delta.Y
			)
	end
end)

--==================================================
-- SHUTDOWN
--==================================================

local function Shutdown()

	if not SystemActive then
		return
	end

	SystemActive = false

	Settings.LockOn = false
	LockedTarget = nil

	for _, Connection in ipairs(Connections) do

		if Connection
			and Connection.Connected then

			Connection:Disconnect()
		end
	end

	table.clear(Connections)

	for _, player in Players:GetPlayers() do

		if player.Character then

			local ESP =
				player.Character:FindFirstChild(
					"JackDevESP"
				)

			if ESP then
				ESP:Destroy()
			end
		end
	end

	ScreenGui:Destroy()
end

CloseButton.MouseButton1Click:Connect(
	Shutdown
)

